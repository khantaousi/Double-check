rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function canRead(module) {
      return isSignedIn() && (
        isAdmin() || 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[module] != 'none')
      );
    }

    function canWrite(module) {
      return isSignedIn() && (
        isAdmin() || 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[module] == 'write')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'khantaousi@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'khantaousi@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      // Owner access - NO isAdmin() check here to prevent recursion
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      
      // Admin/Master access
      allow read, write: if isMasterAdmin();
      allow list, update, delete: if isAdmin();
    }

    // 2. Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Config Collection
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}

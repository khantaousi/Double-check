rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'khantaousi@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidTask(data) {
      return data.get('title', '') is string && data.get('title', '').size() <= 200 &&
             data.get('assigneeId', '') is string &&
             data.get('assignedAt', '') is string &&
             data.get('status', 'pending') in ['pending', 'in-progress', 'completed', 'paused'] &&
             (!('history' in data) || data.history is list) &&
             (!('startedAt' in data) || data.startedAt is string) &&
             (!('completedAt' in data) || data.completedAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             (!('isApproved' in data) || data.isApproved is bool) &&
             (!('isRejected' in data) || data.isRejected is bool) &&
             (!('approvedAt' in data) || data.approvedAt is string) &&
             (!('rejectedAt' in data) || data.rejectedAt is string) &&
             (!('approvedBy' in data) || data.approvedBy is string) &&
             (!('rejectedBy' in data) || data.rejectedBy is string) &&
             (!('isSelfAssigned' in data) || data.isSelfAssigned is bool);
    }

    // 1. Products Library
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Config Data
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. User Profiles
    match /users/{userId} {
      allow get, create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'email'])
      );
      allow list, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // 4. Tasks
    match /tasks/{taskId} {
      allow list: if isSignedIn() && (resource.data.assigneeId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (isOwner(resource.data.assigneeId) || isAdmin());
      allow create: if isSignedIn() && isValidTask(incoming()) && (
        isAdmin() || (
          incoming().assigneeId == request.auth.uid &&
          incoming().isSelfAssigned == true &&
          incoming().isApproved == false
        )
      );
      allow update: if isSignedIn() && (isOwner(resource.data.get('assigneeId', '')) || isAdmin()) && (
        // Validation helper for types
        isValidTask(incoming()) && (
          // Admin can change anything
          isAdmin() ||
          // User can change status and timing fields + history
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'startedAt', 'completedAt', 'durationMinutes', 
              'totalPauseMinutes', 'lastPausedAt', 'resumedAt', 'updatedAt',
              'history'
            ]) &&
            incoming().get('assigneeId', '') == existing().get('assigneeId', '') &&
            incoming().get('isSelfAssigned', false) == existing().get('isSelfAssigned', false)
          )
        )
      );
      allow delete: if isAdmin();
    }
    
    // 5. Notifications
    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ['task_assigned', 'task_approved', 'task_needs_approval', 'system'] &&
             data.isRead is bool &&
             data.createdAt is string;
    }

    match /notifications/{notificationId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // 6. Connection Test
    match /test/connection {
      allow read: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'khantaousi@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidTask(data) {
      return data.get('title', '') is string && data.get('title', '').size() <= 1000 &&
             data.get('assigneeId', '') is string &&
             data.get('assigneeName', '') is string &&
             data.get('assignedAt', '') is string &&
             data.get('status', 'pending') in ['pending', 'in-progress', 'completed', 'paused'] &&
             (!('history' in data) || data.history is list) &&
             (!('startedAt' in data) || data.startedAt is string || data.startedAt == null) &&
             (!('completedAt' in data) || data.completedAt is string || data.completedAt == null) &&
             (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt == null) &&
             (!('durationMinutes' in data) || data.durationMinutes is number || data.durationMinutes == null) &&
             (!('totalPauseMinutes' in data) || data.totalPauseMinutes is number || data.totalPauseMinutes == null) &&
             (!('lastPausedAt' in data) || data.lastPausedAt is string || data.lastPausedAt == null) &&
             (!('resumedAt' in data) || data.resumedAt is string || data.resumedAt == null) &&
             (!('isApproved' in data) || data.isApproved is bool) &&
             (!('isRejected' in data) || data.isRejected is bool) &&
             (!('isEveryday' in data) || data.isEveryday is bool) &&
             (!('isHistorySnapshot' in data) || data.isHistorySnapshot is bool) &&
             (!('isSelfAssigned' in data) || data.isSelfAssigned is bool) &&
             (!('order' in data) || data.order is number || data.order == null) &&
             (!('createdBy' in data) || data.createdBy is string) &&
             (!('description' in data) || data.description is string || data.description == null);
    }

    // 1. Products Library
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Config Data
    match /config/{configId} {
      allow read: if isSignedIn() || configId == 'site_settings';
      allow write: if isAdmin();
    }

    // 3. User Profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'email'])
      );
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    // 4. Tasks
    match /tasks/{taskId} {
      allow list: if isSignedIn() && (resource.data.assigneeId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (isOwner(resource.data.assigneeId) || isAdmin());
      allow create: if isSignedIn() && isValidTask(incoming()) && (
        isAdmin() || (
          // User can create archive tasks for themselves
          incoming().assigneeId == request.auth.uid &&
          (
            (incoming().isSelfAssigned == true && incoming().isApproved == false) ||
            (incoming().isHistorySnapshot == true)
          )
        )
      );
      allow update: if isSignedIn() && (isOwner(resource.data.get('assigneeId', '')) || isAdmin()) && (
        // Validation helper for types
        isValidTask(incoming()) && (
          // Admin can change anything
          isAdmin() ||
          // User can change status and timing fields + history
          (
            // Regular updates (status, timing)
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'startedAt', 'completedAt', 'durationMinutes', 
              'totalPauseMinutes', 'lastPausedAt', 'resumedAt', 'updatedAt',
              'history'
            ]) ||
            // Maintenance reset for everyday tasks
            (
              existing().get('isEveryday', false) == true &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'startedAt', 'completedAt', 'durationMinutes', 
                'totalPauseMinutes', 'lastPausedAt', 'resumedAt', 'updatedAt',
                'history', 'assignedAt', 'isApproved', 'isRejected'
              ]) &&
              incoming().get('status', '') == 'pending' &&
              incoming().get('isApproved', true) == false
            )
          ) &&
          incoming().get('assigneeId', '') == existing().get('assigneeId', '') &&
          incoming().get('isSelfAssigned', false) == existing().get('isSelfAssigned', false)
        )
      );
      allow delete: if isAdmin();
    }
    
    // 5. Notifications
    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ['task_assigned', 'task_approved', 'task_needs_approval', 'task_resent', 'system', 'phone_handover'] &&
             data.isRead is bool &&
             data.createdAt is string;
    }

    match /notifications/{notificationId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    // 6. Connection Test
    match /test/connection {
      allow read: if true;
    }

    // 7. User daily sessions
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        (incoming() != null && incoming().userId == request.auth.uid) || 
        sessionId.matches('^' + request.auth.uid + '_.*') || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // 8. Complaints
    match /complaints/{complaintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 9. Notices
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['viewers'])
      );
    }

    // 10. Phone Devices Inventory
    match /phone_devices/{phoneId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn(); // allow agents to update currentHolder/status/pendingHandover
    }

    // 11. Phone Usage Logs
    match /phone_usage_logs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 12. Phone Deletion Audit Logs (Tracking which admin deleted what)
    match /phone_deletion_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn() && (
        request.auth.token.email == 'khantaousi@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId == '2146' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.loginHandle == '2146' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'khantaousi@gmail.com'
        ))
      );
    }
  }
}

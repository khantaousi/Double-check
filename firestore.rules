rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPermission(module) {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().get(['permissions', module], false) == true)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'khantaousi@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if true;
      
      allow create: if (
        // Only Master Admin can create via the custom interface
        request.auth.token.email == 'khantaousi@gmail.com'
      ) || (
        // Standard users can only create their own profile IF it doesn't exist
        // and we verify the ID matches. Role must be 'user' by default.
        isSignedIn() && request.auth.uid == userId && !exists(/databases/$(database)/documents/users/$(userId)) &&
        incoming().role == 'user'
      );

      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );

      allow delete: if isAdmin();
    }

    // 2. Products Collection
    match /products/{productId} {
      allow read: if hasPermission('products');
      allow write: if isAdmin();
    }

    // 3. Config Collection
    match /config/{configId} {
      allow read: if (
        (configId == 'validation_rules' && hasPermission('rules')) ||
        (configId == 'delivery_settings' && hasPermission('settings')) ||
        (configId == 'site_settings' && hasPermission('settings')) ||
        (configId == 'gift_rules' && (hasPermission('rules') || hasPermission('settings') || hasPermission('dashboard')))
      );
      allow write: if isAdmin();
    }

  }
}
